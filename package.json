{
  "name": "retrorip",
  "version": "1.0.0",
  "description": "RetroRIP \u2014 YouTube to MP3/MP4/AVI/WAV/FLAC converter",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder --win portable",
    "pack": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.mrknight.ytconverter",
    "productName": "RetroRIP",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "electronLanguages": [
      "en-US"
    ],
    "artifactName": "RetroRIP-${version}.${ext}"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.54.0",
    "@fluentui/react-icons": "^2.0.240",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.2.5",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.5"
  },
  "author": "Mr Knight",
  "license": "MIT"
}
